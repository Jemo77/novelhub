# --- Servidor ---------------------------------------------------------------
PORT=3001

# --- Base de datos ----------------------------------------------------------
# PostgreSQL local o un proveedor compatible (Neon, Supabase, Railway).
DATABASE_URL="postgresql://usuario:password@localhost:5432/novelhub?schema=public"

# --- Autenticación ----------------------------------------------------------
# Generá un secreto largo y aleatorio, por ejemplo: openssl rand -base64 48
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# --- Cloudflare R2 ----------------------------------------------------------
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="novelhub"
# URL pública del bucket o dominio personalizado para portadas e imágenes.
R2_PUBLIC_URL="https://<bucket-publico>.r2.dev"

# --- API --------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001"

# --- Web3 -------------------------------------------------------------------
# Contrato ERC-20 de USDT usado por el paywall de capítulos premium.
NEXT_PUBLIC_USDT_ADDRESS="0x0000000000000000000000000000000000000000"

# --- Cloudflare R2 ----------------------------------------------------------
# Se usan solo del lado del servidor para firmar la descarga de libros.
# No agregar el prefijo NEXT_PUBLIC_ a estas variables.
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="novelhub"
